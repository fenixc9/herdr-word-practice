#!/bin/sh
# Thin launcher so the plugin can be run from any cwd, or via a symlink such as
#   ln -s <plugin>/scripts/words ~/.local/bin/words
#
# herdr resolves a relative command against the plugin root (0.9.0+), but the
# python module path still needs the root on sys.path — main.py handles that.
set -e

# Follow symlinks so `words` works from PATH, not just from the plugin dir.
target=$0
while [ -L "$target" ]; do
    here=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd)
    target=$(readlink "$target")
    case $target in
        /*) ;;
        *) target=$here/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$target")/.." && pwd)

if [ -n "$HERDR_WORDS_PYTHON" ]; then
    exec "$HERDR_WORDS_PYTHON" "$root/main.py" "$@"
fi
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/main.py" "$@"
fi
if command -v python >/dev/null 2>&1; then
    exec python "$root/main.py" "$@"
fi
echo "words: python3 not found" >&2
exit 127